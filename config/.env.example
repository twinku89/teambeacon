# Local SQLite path used by TeamBeacon API/runtime.
# Relative paths are resolved from repo root.
TEAMBEACON_DB_PATH=data/teambeacon.db

JIRA_BASE_URL=https://your-jira-host.example.com
JIRA_PAT=replace-with-pat-token
JIRA_PROJECT_KEY=PROJECTKEY
JIRA_BOARD_ID=12345
JIRA_STORY_POINTS_FIELD=customfield_10016
JIRA_EPIC_LINK_FIELD=customfield_10902
JIRA_SPRINT_FIELDS=sprint,customfield_10901,customfield_10020
JIRA_AUTH_MODE=pat_bearer
# Security Insights create-ticket template.
# REV-5404 is read when available; the IDs below preserve the same template if it is deleted or inaccessible.
JIRA_SECURITY_CREATE_SAMPLE_KEY=REV-5404
JIRA_SECURITY_CREATE_PROJECT_ID=19824
JIRA_SECURITY_CREATE_ISSUE_TYPE_ID=7
JIRA_SECURITY_CREATE_ISSUE_TYPE_NAME=Story
# Optional: PEM file containing your corporate/internal CA certificate chain.
# JIRA_CA_BUNDLE=/absolute/path/to/corporate-ca.pem
# JIRA_USERNAME=firstname.lastname@example.com
# JIRA_TIMEOUT_SECONDS=30

# Confluence
CONFLUENCE_BASE_URL=https://your-confluence-host.example.com
CONFLUENCE_PAT=replace-with-confluence-pat-token
CONFLUENCE_AUTH_MODE=pat_bearer
# Optional: shared alternative for both Jira and Confluence: ATLASSIAN_CA_BUNDLE.
# CONFLUENCE_CA_BUNDLE=/absolute/path/to/corporate-ca.pem
# CONFLUENCE_USERNAME=firstname.lastname@example.com
# CONFLUENCE_TIMEOUT_SECONDS=30

# Jenkins
JENKINS_RELEASE_PIPELINE_URL=https://your-jenkins-host.example.com/job/team/job/release
JENKINS_SECURITY_AUDIT_PIPELINE_URL=https://your-jenkins-host.example.com/job/team/job/security-audit
JENKINS_API_AUTH_USER=firstname.lastname@example.com
JENKINS_API_AUTH_TOKEN=replace-with-jenkins-api-token
# JENKINS_CA_BUNDLE=/absolute/path/to/corporate-ca.pem
# JENKINS_TIMEOUT_SECONDS=30

# Active AI provider for TeamBeacon intelligence features.
# Supported values: oci, ollama, openai
INTELLIGENCE_PROVIDER=ollama

# OCI GenAI (TeamBeacon AI features)
OCI_GENAI_COMPARTMENT_ID=ocid1.compartment.oc1..replace-with-compartment-ocid
OCI_GENAI_ENDPOINT=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com
OCI_GENAI_MODEL_ID=cohere.command-r-08-2024
OCI_GENAI_CONFIG_PROFILE=DEFAULT
OCI_GENAI_CONFIG_FILE=~/.oci/config
OCI_GENAI_MAX_TOKENS=1000
OCI_GENAI_TEMPERATURE=1
OCI_GENAI_TOP_P=0.75
OCI_GENAI_TOP_K=0
OCI_GENAI_FREQUENCY_PENALTY=0
OCI_GENAI_CONNECT_TIMEOUT_SECONDS=10
OCI_GENAI_READ_TIMEOUT_SECONDS=240

# Ollama (used when INTELLIGENCE_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Docker override for Ollama from inside TeamBeacon container.
# Linux/macOS Docker default: http://host.docker.internal:11434
# Rancher Desktop:        http://host.rancher-desktop.internal:11434
OLLAMA_BASE_URL_DOCKER=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_NUM_CTX=12288
OLLAMA_MAX_TOKENS=1200
OLLAMA_TEMPERATURE=1
OLLAMA_TOP_P=0.75
OLLAMA_TOP_K=0
OLLAMA_REPEAT_PENALTY=1
OLLAMA_CONNECT_TIMEOUT_SECONDS=10
OLLAMA_READ_TIMEOUT_SECONDS=240

# OpenAI (used when INTELLIGENCE_PROVIDER=openai)
# OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=600
OPENAI_TEMPERATURE=1
OPENAI_TOP_P=0.75
OPENAI_FREQUENCY_PENALTY=0
OPENAI_CONNECT_TIMEOUT_SECONDS=10
OPENAI_READ_TIMEOUT_SECONDS=240

# Set to 1 when you intentionally run live integration tests.
RUN_LIVE_JIRA_TESTS=0
